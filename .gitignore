# ── 비밀값 파일 ──
# 환경변수 파일(API 키·토큰 등)
.env
# .env.local, .env.production 같은 변형도 제외
.env.*
# 값 없이 항목 이름만 적은 예시 파일은 저장소에 남김
!.env.example
# 인증서·개인 키 파일
*.pem
*.key
# 비밀값을 모아 두는 파일
secrets.*
*.secret

# ── 원자료 ──
# raw/는 공개·예시 자료만 두는 곳이라 저장소에 포함함
# 회사명·실제 값·개인정보가 든 자료는 raw/가 아니라 private/에만 둘 것(아래에서 통째로 제외)

# ── 회사 맥락·사례 ──
# 회사명·운영사명·실제 값·사례가 든 폴더 전체 제외
private/

# ── 강의자료 ──
# 작업 대상이 아니고 재배포 권한이 불분명한 강의자료 폴더 전체 제외
강의자료/

# ── 운영체제가 만드는 파일 ──
# macOS 폴더 표시 정보
.DS_Store
# Windows 썸네일 캐시
Thumbs.db

# ── 한글·오피스 임시 파일 ──
# Word·Excel·PowerPoint·한글이 열려 있는 동안 만드는 잠금 파일
~$*
# Word 임시 저장 파일
~WRL*.tmp
# 한글 자동 저장(백업) 파일
*.asv
# LibreOffice 잠금 파일
.~lock.*#
# 일반 임시 파일
*.tmp

# ── PDF ──
# 원문·자료 PDF는 용량과 저작권 문제로 제외
*.pdf

# ── Claude Code 개인 설정 ──
# 개인 권한 허용 목록(공유용 settings.json은 저장소에 남김)
.claude/settings.local.json

# ── Node 의존성 ──
# pi 로컬 설치물(package.json으로 재설치 가능)
node_modules/
